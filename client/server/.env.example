DATABASE_URL="postgresql://mpp_user:mpp_pass@localhost:5432/mpp_app?schema=public"
MONGODB_URI="mongodb://localhost:27017/mpp_chat"
PORT=3001
HOST=0.0.0.0
# Local dev uses self-signed certs (true); in the cloud the platform terminates TLS, so set false.
USE_HTTPS=false
JWT_SECRET=music-core-dev-secret-change-in-production
# Public URL of the FRONTEND — used for email links and the GitHub post-login redirect.
APP_URL=http://127.0.0.1:5173

# Email — when configured, password-reset and magic-link tokens are emailed to users.
# Cloud hosts (Render, etc.) BLOCK outbound SMTP ports, so in production use the Brevo
# HTTP API: set BREVO_API_KEY (Brevo -> SMTP & API -> API Keys). It is preferred over SMTP.
BREVO_API_KEY=
# SMTP is used only if BREVO_API_KEY is empty (handy for local dev).
# Brevo: smtp-relay.brevo.com / 587   |   Gmail: smtp.gmail.com / 587 (App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Music Core <no-reply@musiccore.app>

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must point at the BACKEND callback route in production: https://<backend>/auth/github/callback
GITHUB_CALLBACK_URL=http://127.0.0.1:5173/auth/callback
